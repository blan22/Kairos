{
  "name": "kairos-vscode",
  "displayName": "kairos",
  "description": "kairos의 지금 볼 일과 열린 항목을 VS Code에서 보고 처리한다.",
  "version": "0.3.0",
  "publisher": "kairos",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kairos",
          "title": "kairos",
          "icon": "$(bell)"
        }
      ]
    },
    "views": {
      "kairos": [
        {
          "id": "kairos.items",
          "name": "남은 일"
        }
      ]
    },
    "commands": [
      {
        "command": "kairos.refresh",
        "title": "kairos: 새로고침",
        "icon": "$(refresh)"
      },
      {
        "command": "kairos.add",
        "title": "kairos: 할 일 추가",
        "icon": "$(add)"
      },
      {
        "command": "kairos.later",
        "title": "나중에",
        "icon": "$(clock)"
      },
      {
        "command": "kairos.done",
        "title": "완료",
        "icon": "$(check)"
      },
      {
        "command": "kairos.keep",
        "title": "새 소식이 오면 다시"
      },
      {
        "command": "kairos.keepDeploy",
        "title": "배포 때 다시"
      },
      {
        "command": "kairos.start",
        "title": "세션 열고 시작",
        "icon": "$(play)"
      },
      {
        "command": "kairos.move",
        "title": "세션으로 이동",
        "icon": "$(terminal)"
      },
      {
        "command": "kairos.cancel",
        "title": "되돌리기"
      },
      {
        "command": "kairos.pr",
        "title": "PR 올리기",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "kairos.open",
        "title": "원문 열기",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kairos.refresh",
          "when": "view == kairos.items",
          "group": "navigation"
        },
        {
          "command": "kairos.add",
          "when": "view == kairos.items",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kairos.start",
          "when": "view == kairos.items && viewItem =~ /\\bstart\\b/",
          "group": "1@1"
        },
        {
          "command": "kairos.later",
          "when": "view == kairos.items && viewItem =~ /\\blater\\b/",
          "group": "1@2"
        },
        {
          "command": "kairos.done",
          "when": "view == kairos.items && viewItem =~ /\\bdone\\b/",
          "group": "1@3"
        },
        {
          "command": "kairos.keep",
          "when": "view == kairos.items && viewItem =~ /\\bkeep\\b/",
          "group": "1@4"
        },
        {
          "command": "kairos.keepDeploy",
          "when": "view == kairos.items && viewItem =~ /\\bkeep_deploy\\b/",
          "group": "1@5"
        },
        {
          "command": "kairos.move",
          "when": "view == kairos.items && viewItem =~ /\\bmove\\b/",
          "group": "2@1"
        },
        {
          "command": "kairos.pr",
          "when": "view == kairos.items && viewItem =~ /\\bpr\\b/",
          "group": "2@2"
        },
        {
          "command": "kairos.cancel",
          "when": "view == kairos.items && viewItem =~ /\\bcancel\\b/",
          "group": "2@3"
        },
        {
          "command": "kairos.open",
          "when": "view == kairos.items && viewItem =~ /\\burl\\b/",
          "group": "3@1"
        },
        {
          "command": "kairos.start",
          "when": "view == kairos.items && viewItem =~ /\\bstart\\b/",
          "group": "inline@1"
        },
        {
          "command": "kairos.move",
          "when": "view == kairos.items && viewItem =~ /\\bmove\\b/",
          "group": "inline@1"
        },
        {
          "command": "kairos.open",
          "when": "view == kairos.items && viewItem =~ /\\burl\\b/",
          "group": "inline@2"
        },
        {
          "command": "kairos.done",
          "when": "view == kairos.items && viewItem =~ /\\bdone\\b/",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "kairos.later",
          "when": "false"
        },
        {
          "command": "kairos.done",
          "when": "false"
        },
        {
          "command": "kairos.keep",
          "when": "false"
        },
        {
          "command": "kairos.keepDeploy",
          "when": "false"
        },
        {
          "command": "kairos.start",
          "when": "false"
        },
        {
          "command": "kairos.move",
          "when": "false"
        },
        {
          "command": "kairos.cancel",
          "when": "false"
        },
        {
          "command": "kairos.pr",
          "when": "false"
        },
        {
          "command": "kairos.open",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.cjs",
    "check": "tsc --noEmit -p .",
    "test": "node --test src/*.test.ts",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}

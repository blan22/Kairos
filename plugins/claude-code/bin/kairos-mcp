#!/bin/sh
# kairos mcp serve를 띄운다. 실행 파일은 설치본의 current 링크만 쓴다(환경 변수로 바꾸지 않는다).
# 본인 소유가 아니거나 다른 사용자가 고칠 수 있으면 띄우지 않는다.
# 자리는 kairos_core::platform::Os::default_data_dir와 같다.
#   macOS   ~/Library/Application Support/kairos
#   Linux   ~/.local/share/kairos
#   Windows %USERPROFILE%\AppData\Local\kairos (Git Bash 같은 sh에서 뜬다. 권한 비트가 없어 kairos가 자리를 본다)
# 검사에 쓰는 도구는 시스템 폴더에서만 찾는다. 프로젝트 폴더에서 뜨므로 PATH의 . 이나 빈 항목이 검사보다 먼저 돌면 안 된다.
# kairos에는 원래 PATH를 넘긴다. Git Bash의 cygpath와 uname도 /usr/bin에 있다.
user_path=$PATH
PATH=/usr/bin:/bin
case "$(uname -s)" in
  Darwin)
    kairos="$HOME/Library/Application Support/kairos/current/bin/kairos"
    owner_of() { /usr/bin/stat -L -f '%u' "$1"; }
    mode_of() { /usr/bin/stat -L -f '%Lp' "$1"; }
    ;;
  Linux)
    kairos="$HOME/.local/share/kairos/current/bin/kairos"
    owner_of() { stat -L -c '%u' "$1"; }
    mode_of() { stat -L -c '%a' "$1"; }
    ;;
  MINGW* | MSYS* | CYGWIN*)
    if [ -z "$USERPROFILE" ]; then
      echo "USERPROFILE을 알 수 없습니다" >&2
      exit 1
    fi
    kairos="$(cygpath -u "$USERPROFILE")/AppData/Local/kairos/current/bin/kairos.exe"
    if [ ! -f "$kairos" ]; then
      echo "kairos가 설치되지 않았습니다. kairos install --apply를 실행하세요" >&2
      exit 1
    fi
    PATH=$user_path
    exec "$kairos" mcp serve
    ;;
  *)
    echo "지원하지 않는 OS입니다" >&2
    exit 1
    ;;
esac
if [ ! -x "$kairos" ]; then
  echo "kairos가 설치되지 않았습니다. kairos install --apply를 실행하세요" >&2
  exit 1
fi
owner=$(owner_of "$kairos")
mode=$(mode_of "$kairos")
if [ "$owner" != "$(id -u)" ] || [ $(( 0$mode & 022 )) -ne 0 ]; then
  echo "kairos 실행 파일의 소유자나 권한이 맞지 않습니다" >&2
  exit 1
fi
PATH=$user_path
exec "$kairos" mcp serve

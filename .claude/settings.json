{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh *)",
      "Bash(./scripts/verify.sh *)",
      "Bash(./scripts/check-personal-data.sh)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo tree *)",
      "Bash(node --test plugins/collector/test/tick.test.ts)",
      "Bash(node --test packages/kairos-client/src/index.test.ts)",
      "Bash(node --test plugins/vscode/src/model.test.ts)",
      "Bash(node --test scripts/harness/hooks.test.mjs)",
      "Bash(node --test scripts/harness/layout.test.mjs)",
      "Bash(npm --prefix storybook run gen)",
      "Bash(npm --prefix storybook run build)",
      "Bash(npm --prefix storybook test)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(claude plugin validate *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/Library/Application Support/kairos/session-gh-token)",
      "Read(~/Library/Application Support/kairos/session-settings/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.ssh/**)",
      "Edit(~/Library/Application Support/kairos/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Bash(git push --force *)",
      "Bash(launchctl bootstrap *)",
      "Bash(launchctl bootout *)",
      "Bash(git * --output*)",
      "Bash(git * --output=*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.mjs\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
